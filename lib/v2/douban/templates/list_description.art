{{ if ranking_value }}
<p>{{ ranking_value }}<p>
{{ /if }}

<p>{{ title }}</p>

{{ if original_title }}
<p>{{ original_title }}</p>
{{ /if }}

{{ include './rating_stars.art' }}

{{ if card_subtitle }}
<p>{{ card_subtitle }}</p>
{{ /if }}

{{ if description }}
<p>{{ description }}</p>
{{ /if }}

{{ include './details_block.art' }}

{{ if telegram_search_http_link }}
<p><a href="{{ telegram_search_http_link }}">Telegram 搜索资源</a></p>
{{ /if }}

{{ if telegram_search_link }}
<p><a href="{{ telegram_search_link }}">Telegram 搜索资源（客户端）</a></p>
{{ /if }}

{{ if cover }}
<img src="{{ cover }}" />
{{ /if }}
