{{ if ranking_value }}
<p>{{ ranking_value }}<p>
{{ /if }}

<p>{{ title }}</p>

{{ if original_title }}
<p>{{ original_title }}</p>
{{ /if }}

{{ include './rating_stars.art' }}

{{ if card_subtitle }}
<p>{{ card_subtitle }}</p>
{{ /if }}

{{ if description }}
<p>{{ description }}</p>
{{ /if }}

{{ include './details_block.art' }}

{{ if cover }}
<img src="{{ cover }}" />
{{ /if }}
