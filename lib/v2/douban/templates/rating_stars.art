{{ if rate !== null && rate !== undefined }}
<p>
    <span><strong>评分:</strong> {{rate}}</span>
    <span style="display:inline-block; margin-left:6px; letter-spacing:1px; font-size: 14px; line-height: 1;">
        {{ if stars >= 1 }}★{{ else }}☆{{ /if }}
        {{ if stars >= 2 }}★{{ else }}☆{{ /if }}
        {{ if stars >= 3 }}★{{ else }}☆{{ /if }}
        {{ if stars >= 4 }}★{{ else }}☆{{ /if }}
        {{ if stars >= 5 }}★{{ else }}☆{{ /if }}
    </span>
</p>
{{ /if }}
