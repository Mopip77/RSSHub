{{ if rate !== null && rate !== undefined }}
<p>
    <span><strong>评分:</strong> {{rate}}</span>
    <span style="display:inline-block; margin-left:6px; letter-spacing:1px; font-size: 14px; line-height: 1;">
        {{ if stars >= 1 }}<span style="color:#f5a623;">&#9733;</span>{{ else }}<span style="color:#c8c8c8;">&#9733;</span>{{ /if }}
        {{ if stars >= 2 }}<span style="color:#f5a623;">&#9733;</span>{{ else }}<span style="color:#c8c8c8;">&#9733;</span>{{ /if }}
        {{ if stars >= 3 }}<span style="color:#f5a623;">&#9733;</span>{{ else }}<span style="color:#c8c8c8;">&#9733;</span>{{ /if }}
        {{ if stars >= 4 }}<span style="color:#f5a623;">&#9733;</span>{{ else }}<span style="color:#c8c8c8;">&#9733;</span>{{ /if }}
        {{ if stars >= 5 }}<span style="color:#f5a623;">&#9733;</span>{{ else }}<span style="color:#c8c8c8;">&#9733;</span>{{ /if }}
    </span>
</p>
{{ /if }}
